[Unit]
Description=EMS HMI Server — L5 Cloud layer (7-screen React frontend, WebSocket telemetry)
Documentation=https://github.com/ReVx-Energy/EMS
After=network.target data_manager.service
PartOf=ems.target

[Service]
Type=simple
ExecStart=/opt/ems/python/.venv/bin/python -m ems_hmi_server
Restart=on-failure
RestartSec=5
User=ems
Group=ems
WorkingDirectory=/opt/ems
StandardOutput=journal
StandardError=journal
# HMI serves on port 8080
Environment=EMS_HMI_PORT=8080

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=ems.target
