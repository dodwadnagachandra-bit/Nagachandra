[Unit]
Description=EMS Logger — L3 Data layer (Parquet 1Hz, DuckDB, JSONL events)
Documentation=https://github.com/ReVx-Energy/EMS
After=network.target ems-data-manager.service comm_manager.service
Wants=ems-data-manager.service
PartOf=ems.target

[Service]
Type=simple
ExecStart=/opt/ems/python/.venv/bin/python -m ems_logger --config /opt/ems/config/logger_config.yaml
Environment=EMS_CONFIG_DIR=/opt/ems/config
Restart=on-failure
RestartSec=5
User=ems
Group=ems
WorkingDirectory=/opt/ems
StandardOutput=journal
StandardError=journal

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=ems.target
