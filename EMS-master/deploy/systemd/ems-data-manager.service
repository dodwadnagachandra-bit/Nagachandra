[Unit]
Description=EMS Data Manager (C) - RTDB Owner
After=network.target
Before=ems-data-manager-python.service ems-config-manager.service ems-safety-manager.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /run/ems
ExecStart=/opt/ems/bin/data_manager_c 1 4 10 16 8
ExecStop=/bin/rm -f /dev/shm/ems_rtdb
Restart=always
RestartSec=1
User=ems
Group=ems

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
SystemCallFilter=@system-service
MemoryMax=64M
MemoryHigh=48M

[Install]
WantedBy=multi-user.target
