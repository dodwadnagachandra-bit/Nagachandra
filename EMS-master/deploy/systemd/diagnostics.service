[Unit]
Description=EMS Diagnostics — L4 App layer (health monitoring, prognostics)
Documentation=https://github.com/ReVx-Energy/EMS
After=network.target data_manager.service logger.service
PartOf=ems.target

[Service]
Type=simple
ExecStart=/opt/ems/python/.venv/bin/python -m ems_diagnostics
Restart=on-failure
RestartSec=5
User=ems
Group=ems
WorkingDirectory=/opt/ems
StandardOutput=journal
StandardError=journal

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=ems.target
