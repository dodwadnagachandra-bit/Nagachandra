[Unit]
Description=EMS Control Manager — L4 App layer (1Hz state machine, power dispatch)
Documentation=https://github.com/ReVx-Energy/EMS
After=network.target data_manager.service comm_manager.service config_manager.service
PartOf=ems.target

[Service]
Type=simple
# Note: C component (control_manager_c) is launched as subprocess by Python orchestrator
ExecStart=/opt/ems/python/.venv/bin/python -m ems_control_manager
Restart=on-failure
RestartSec=5
User=ems
Group=ems
WorkingDirectory=/opt/ems
StandardOutput=journal
StandardError=journal

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=ems.target
