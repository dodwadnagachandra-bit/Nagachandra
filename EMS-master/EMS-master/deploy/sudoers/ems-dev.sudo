# deploy/sudoers/ems-dev.sudo
# Passwordless sudo rules for EMS development.
#
# Install: sudo cp deploy/sudoers/ems-dev.sudo /etc/sudoers.d/ems-dev
#          sudo chmod 0440 /etc/sudoers.d/ems-dev
#
# Grants members of the 'ems' group passwordless access to:
#   - Load CAN kernel modules (vcan, can, can_raw)
#   - Create/configure virtual CAN interfaces
#
# These are the only commands that require root during normal development.
# The TUI process manager and simulators run as the regular user.

# CAN kernel modules
%ems ALL=(root) NOPASSWD: /sbin/modprobe vcan, /sbin/modprobe can, /sbin/modprobe can_raw
%ems ALL=(root) NOPASSWD: /usr/sbin/modprobe vcan, /usr/sbin/modprobe can, /usr/sbin/modprobe can_raw

# Virtual CAN interface management
%ems ALL=(root) NOPASSWD: /sbin/ip link add dev vcan0 type vcan
%ems ALL=(root) NOPASSWD: /sbin/ip link set up vcan0
%ems ALL=(root) NOPASSWD: /usr/sbin/ip link add dev vcan0 type vcan
%ems ALL=(root) NOPASSWD: /usr/sbin/ip link set up vcan0
%ems ALL=(root) NOPASSWD: /usr/bin/ip link add dev vcan0 type vcan
%ems ALL=(root) NOPASSWD: /usr/bin/ip link set up vcan0
