[Unit]
Description=EMS Communication Manager - Modbus RTU Polling
Documentation=https://github.com/ReVx-Energy/EMS
After=ems-safety-manager.service ems-data-manager.service
Wants=ems-data-manager.service
PartOf=ems.target

[Service]
Type=exec
ExecStart=/opt/ems/python/.venv/bin/python -m ems_comm_manager --config /opt/ems/config
Restart=always
RestartSec=3
User=ems
Group=ems
SupplementaryGroups=dialout
WorkingDirectory=/opt/ems
Environment=EMS_PROFILE=residential
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ems-comm-manager

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=ems.target
