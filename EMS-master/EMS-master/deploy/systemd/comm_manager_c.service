[Unit]
Description=EMS Communication Manager - CAN BMS Decode
Documentation=https://github.com/ReVx-Energy/EMS
After=ems-safety-manager.service ems-data-manager.service
Wants=ems-data-manager.service
PartOf=ems.target

[Service]
Type=exec
ExecStart=/opt/ems/bin/comm_manager_c --interface can0 --base-id 0x18FF0003 --heartbeat-timeout-ms 900
Restart=always
RestartSec=1
User=ems
Group=ems
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_RAW
WorkingDirectory=/opt/ems
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ems-comm-manager-c

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no
# NoNewPrivileges=no required for AmbientCapabilities (CAP_NET_RAW)
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
CapabilityBoundingSet=CAP_NET_RAW
SystemCallFilter=@system-service @io-event
MemoryMax=64M
MemoryHigh=48M
# Do NOT add CPUQuota -- C binary is lightweight and critical

[Install]
WantedBy=ems.target
