[Unit]
Description=EMS Config Manager — L3 Data layer (YAML config, JSON Schema, hot-reload)
Documentation=https://github.com/ReVx-Energy/EMS
After=network.target
PartOf=ems.target

[Service]
Type=simple
ExecStart=/opt/ems/python/.venv/bin/python -m ems_config_manager
Restart=on-failure
RestartSec=5
User=ems
Group=ems
WorkingDirectory=/opt/ems
StandardOutput=journal
StandardError=journal

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=ems.target
