[Unit]
Description=EMS Data Manager (Python) - Telemetry Publisher
After=ems-data-manager.service
Requires=ems-data-manager.service

[Service]
Type=simple
ExecStart=/opt/ems/python/.venv/bin/python -m ems_data_manager
Restart=always
RestartSec=2
User=ems
Group=ems

# Security hardening — production (PROD-06)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/data /run/ems /dev/shm
RuntimeDirectory=ems
MemoryMax=256M
MemoryHigh=200M
CPUQuota=50%
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
