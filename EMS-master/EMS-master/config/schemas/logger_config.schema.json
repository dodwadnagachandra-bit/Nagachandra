{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revx-energy.com/ems/schemas/logger_config",
  "title": "EMS Logger Configuration",
  "description": "Configuration for the EMS logger module: telemetry persistence (Parquet), event logging (JSONL), disk retention, and query settings.",
  "type": "object",
  "required": ["_schema_version", "storage", "parquet", "query"],
  "additionalProperties": false,
  "properties": {
    "_schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version for migration detection."
    },
    "storage": {
      "type": "object",
      "description": "Data storage paths and retention settings.",
      "required": [
        "data_dir",
        "parquet_retention_days",
        "jsonl_retention_days",
        "disk_usage_threshold_pct",
        "cleanup_interval_s"
      ],
      "additionalProperties": false,
      "properties": {
        "data_dir": {
          "type": "string",
          "description": "Base directory for Parquet and JSONL data files."
        },
        "parquet_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Days to retain raw Parquet telemetry files (LOG-05)."
        },
        "jsonl_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730,
          "description": "Days to retain JSONL event files (2x Parquet default)."
        },
        "disk_usage_threshold_pct": {
          "type": "integer",
          "minimum": 50,
          "maximum": 95,
          "description": "Disk usage percentage that triggers FIFO cleanup (LOG-06)."
        },
        "cleanup_interval_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600,
          "description": "Seconds between disk usage checks and cleanup runs."
        }
      }
    },
    "parquet": {
      "type": "object",
      "description": "Parquet file writing settings.",
      "required": ["compression", "rotation_period_s", "row_group_size"],
      "additionalProperties": false,
      "properties": {
        "compression": {
          "type": "string",
          "enum": ["snappy", "zstd", "none"],
          "description": "Parquet compression codec (LOG-08)."
        },
        "rotation_period_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "description": "Seconds between Parquet file rotations (LOG-02)."
        },
        "row_group_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Number of rows per Parquet row group."
        }
      }
    },
    "query": {
      "type": "object",
      "description": "DuckDB query interface settings.",
      "required": [
        "socket",
        "time_series_max_rows",
        "time_series_timeout_s",
        "latest_timeout_s",
        "range_stats_timeout_s",
        "event_log_max_rows",
        "event_log_timeout_s",
        "energy_totals_timeout_s",
        "cell_snapshot_timeout_s"
      ],
      "additionalProperties": false,
      "properties": {
        "socket": {
          "type": "string",
          "description": "ZMQ REP socket path for query endpoint."
        },
        "time_series_max_rows": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum rows returned by time_series queries."
        },
        "time_series_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Timeout in seconds for time_series queries."
        },
        "latest_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Timeout in seconds for latest queries."
        },
        "range_stats_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Timeout in seconds for range_stats queries."
        },
        "event_log_max_rows": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum rows returned by event_log queries."
        },
        "event_log_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Timeout in seconds for event_log queries."
        },
        "energy_totals_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Timeout in seconds for energy_totals queries."
        },
        "cell_snapshot_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Timeout in seconds for cell_snapshot queries."
        }
      }
    }
  }
}
