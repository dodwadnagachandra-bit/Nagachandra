{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revx-energy.com/ems/schemas/gpio_config",
  "title": "EMS GPIO Safety I/O Configuration",
  "description": "Configuration for the 8 digital input (DI) and 8 digital output (DO) safety GPIO pins on the ECU-1170-552A. Inputs monitor safety sensors (E-Stop, fire, flood). Outputs control safety actuators (ACDB trip, PCS stop, siren). Pin assignments must match physical wiring \u2014 incorrect configuration is a safety risk.",
  "type": "object",
  "required": [
    "_schema_version",
    "digital_inputs",
    "digital_outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "_schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version for migration detection. Must match the schema expected version."
    },
    "digital_inputs": {
      "type": "object",
      "description": "Digital input pin configuration. 8 inputs (DI-0 to DI-7) for safety sensor monitoring. All inputs are read by safety_manager at <100ms scan rate.",
      "required": [
        "DI-0",
        "DI-1",
        "DI-2",
        "DI-3",
        "DI-4",
        "DI-5",
        "DI-6",
        "DI-7"
      ],
      "additionalProperties": false,
      "properties": {
        "DI-0": {
          "type": "object",
          "description": "Digital input 0 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin. Used in alarms and event logs."
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of the physical sensor connected to this input."
            },
            "active_low": {
              "type": "boolean",
              "description": "If true, the input is active (asserted) when the GPIO signal is low (0V). Typical for normally-closed relay contacts."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Input debounce time. Signal must be stable for this duration before state change is registered. Prevents false triggers from contact bounce.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-1": {
          "type": "object",
          "description": "Digital input 1 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-2": {
          "type": "object",
          "description": "Digital input 2 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-3": {
          "type": "object",
          "description": "Digital input 3 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-4": {
          "type": "object",
          "description": "Digital input 4 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-5": {
          "type": "object",
          "description": "Digital input 5 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-6": {
          "type": "object",
          "description": "Digital input 6 configuration. Typically E-Stop channel 1 (NO contact \u2014 normally open, breaks on activation).",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        },
        "DI-7": {
          "type": "object",
          "description": "Digital input 7 configuration. Typically E-Stop channel 2 (NC contact \u2014 normally closed, closes on activation). Dual-channel E-Stop provides fail-safe wiring verification.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this input pin."
            },
            "description": {
              "type": "string",
              "description": "Physical sensor description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "debounce_ms": {
              "type": "integer",
              "description": "Debounce time in milliseconds.",
              "minimum": 0,
              "maximum": 100,
              "x-unit": "ms"
            }
          }
        }
      }
    },
    "fault_injection": {
      "type": "object",
      "description": "Optional fault injection settings for GPIO harness testing. When present, the harness applies configured faults to emulate degraded GPIO behavior.",
      "additionalProperties": false,
      "properties": {
        "stuck_pins": {
          "type": "array",
          "description": "DI pin numbers that ignore writes (simulate stuck/failed input sensors).",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        },
        "stuck_values": {
          "type": "object",
          "description": "Pin-to-value mapping for stuck pin state. Keys are pin numbers as strings, values are 0 or 1.",
          "additionalProperties": false,
          "patternProperties": {
            "^[0-7]$": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "bounce_ms": {
          "type": "integer",
          "description": "Contact bounce simulation duration in milliseconds. Pin toggles rapidly for this duration after each write.",
          "minimum": 0,
          "x-unit": "ms"
        }
      }
    },
    "digital_outputs": {
      "type": "object",
      "description": "Digital output pin configuration. 8 outputs (DO-0 to DO-7) for safety actuator control. All outputs are driven by safety_manager in <100ms response to safety events.",
      "required": [
        "DO-0",
        "DO-1",
        "DO-2",
        "DO-3",
        "DO-4",
        "DO-5",
        "DO-6",
        "DO-7"
      ],
      "additionalProperties": false,
      "properties": {
        "DO-0": {
          "type": "object",
          "description": "Digital output 0 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this output pin. Used in event logs and HMI status displays."
            },
            "description": {
              "type": "string",
              "description": "Human-readable description of the actuator controlled by this output."
            },
            "active_low": {
              "type": "boolean",
              "description": "If true, the output is active (actuator energized) when the GPIO signal is low. For relay-driven outputs, matches the relay coil logic."
            },
            "initial_state": {
              "type": "string",
              "description": "Initial state of this output on EMS startup, before any control logic runs. 'low' = de-energized/off, 'high' = energized/on.",
              "enum": [
                "low",
                "high"
              ]
            }
          }
        },
        "DO-1": {
          "type": "object",
          "description": "Digital output 1 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Functional name for this output pin."
            },
            "description": {
              "type": "string",
              "description": "Actuator description."
            },
            "active_low": {
              "type": "boolean",
              "description": "Active-low logic inversion."
            },
            "initial_state": {
              "type": "string",
              "description": "Initial output state at startup.",
              "enum": [
                "low",
                "high"
              ]
            }
          }
        },
        "DO-2": {
          "type": "object",
          "description": "Digital output 2 configuration.",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
