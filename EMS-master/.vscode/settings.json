{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },

  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },

  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  "C_Cpp.clang_format_fallbackStyle": "file",
  "editor.rulers": [100],
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "files.associations": {
    "*.schema.json": "jsonc"
  },

  "yaml.schemas": {
    "config/schemas/system_config.schema.json": "config/profiles/*/system_config.yaml",
    "config/schemas/bms_config.schema.json": "config/profiles/*/bms_config.yaml",
    "config/schemas/pcs_config.schema.json": "config/profiles/*/pcs_config.yaml",
    "config/schemas/btms_config.schema.json": "config/profiles/*/btms_config.yaml",
    "config/schemas/meter_config.schema.json": "config/profiles/*/meter_config.yaml",
    "config/schemas/dg_config.schema.json": "config/profiles/*/dg_config.yaml",
    "config/schemas/pv_config.schema.json": "config/profiles/*/pv_config.yaml",
    "config/schemas/control_config.schema.json": "config/profiles/*/control_config.yaml",
    "config/schemas/alarms_config.schema.json": "config/profiles/*/alarms_config.yaml",
    "config/schemas/schedule_config.schema.json": "config/profiles/*/schedule_config.yaml",
    "config/schemas/cloud_config.schema.json": "config/profiles/*/cloud_config.yaml",
    "config/schemas/network_config.schema.json": "config/profiles/*/network_config.yaml",
    "config/schemas/gpio_config.schema.json": "config/profiles/*/gpio_config.yaml",
    "config/schemas/hmi_config.schema.json": "config/profiles/*/hmi_config.yaml"
  },

  "cmake.buildDirectory": "${workspaceFolder}/build",

  "claudeCode.enableBypassPermissions": true,

  "search.exclude": {
    "build/": true,
    "build-arm/": true,
    ".venv/": true,
    "node_modules/": true,
    "__pycache__/": true
  },
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
